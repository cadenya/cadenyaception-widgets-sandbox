{
  "name": "cadenyaception-widgets-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup:cadenya": "node --env-file=.env src/examples/conversation/setup.mjs",
    "test": "npm run test:unit && npm run test:react",
    "dev:poll": "WATCHPACK_POLLING=true next dev",
    "update:widgets": "node scripts/update-widgets.mjs",
    "setup:chess": "node --env-file=.env src/examples/chessboard/setup.mjs",
    "setup:diagram": "node --env-file=.env src/examples/diagram-builder/setup.mjs",
    "setup:all": "npm run setup:cadenya && npm run setup:chess && npm run setup:diagram",
    "format": "prettier --write \"src/examples/**/*.{ts,tsx,mjs,json,md}\" \"scripts/**/*.mjs\" README.md vitest.config.ts",
    "format:check": "prettier --check \"src/examples/**/*.{ts,tsx,mjs,json,md}\" \"scripts/**/*.mjs\" README.md vitest.config.ts",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:react": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cadenya/cadenya": "^1.1.0",
    "@cadenya/widgets-ui-react": "file:vendor/cadenya-widgets-ui-react-4663557fc7de.tgz",
    "@radix-ui/themes": "^3.3.0",
    "@rjsf/core": "^6.8.0",
    "@rjsf/utils": "^6.8.0",
    "@rjsf/validator-ajv8": "^6.8.0",
    "@xyflow/react": "^12.11.6",
    "chess.js": "^1.4.0",
    "devicon": "^2.17.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
