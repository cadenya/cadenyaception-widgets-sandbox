CADENYA_API_KEY=
CADENYA_WORKSPACE_ID=
CADENYA_WIDGET_ID=external_id:cadenyaception-portal
# Comma-separated exact origins.
CADENYA_ALLOWED_ORIGINS=http://localhost:3000,https://widgets-demo.cadenya.com
# Setup: choose an enabled, tool-capable model in your Cadenya workspace.
# List models: cadenya models list --include-info --display json
# Empty preserves existing models; creating a new variation requires a value.
CADENYA_MODEL_ID=
# Optional: a Faker MCP tool-set ID from your workspace for fictional sample data.
# Empty assigns only the examples' bare tools when running setup.
CADENYA_FAKER_TOOL_SET_ID=
# Cloudflare Turnstile: Managed widget allowing your deployment hostname.
# Add localhost for local development. The secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional hostname override. Production must exclude localhost and loopback IPs.
# Defaults: widgets-demo.cadenya.com in production; also localhost in development.
TURNSTILE_HOSTNAMES=
# Optional temporary demo bypass: UTC deadline, e.g. YYYY-MM-DDTHH:mm:ssZ.
# Unset, invalid, or expired values keep Turnstile required.
TURNSTILE_BYPASS_UNTIL=
